#!/usr/bin/env bash
# Forces bash shell and recursively searches all folders
# Finds the file and opens it with the default editor
# Ctrl + Y copies the path of whatever is selected to clipboard and echoes it

LIST_COMMAND="eza"
PREVIEW_COMMAND="batcat"
EDITOR_CMD="${EDITOR:-nvim}"

# Function to check if a command exists
command_exists() {
  command -v "$1" &>/dev/null
}

# Determine system clipboard tool (Wayland, X11, WSL, or macOS)
get_clipboard_cmd() {
  if command_exists "wl-copy"; then
    echo "wl-copy"
  elif command_exists "xclip"; then
    echo "xclip -selection clipboard"
  elif command_exists "xsel"; then
    echo "xsel --clipboard --input"
  elif command_exists "clip.exe"; then
    echo "clip.exe"
  elif command_exists "pbcopy"; then
    echo "pbcopy"
  else
    echo ""
  fi
}

# Check and set up dependencies
setup_dependencies() {
  if ! command_exists "fzf"; then
    echo "Error: fzf is required but not installed"
    exit 1
  fi

  if ! command_exists "$LIST_COMMAND"; then
    LIST_COMMAND="ls"
  fi

  if ! command_exists "$PREVIEW_COMMAND"; then
    PREVIEW_COMMAND="cat"
  fi
}

# Handle selected file/folder: copy absolute path to clipboard and print it
copy_and_print_path() {
  local target="$1"
  local full_path
  full_path="$(realpath "$target")"

  local clip_cmd
  clip_cmd="$(get_clipboard_cmd)"

  if [[ -n "$clip_cmd" ]]; then
    printf "%s" "$full_path" | eval "$clip_cmd"
  fi

  echo "$full_path"
}

# Main function
fzfm() {
  setup_dependencies

  local list_command="fd --type f --type d --hidden \
  --exclude .git \
  --exclude '*cache*' \
  --exclude node_modules \
  --exclude .venv \
  --exclude target \
  --exclude build \
  --exclude dist"

  while true; do
    # Capturar la tecla presionada junto a la selección
    local fzf_output
    fzf_output=$( (
      echo ".."
      eval "$list_command"
    ) | SHELL=bash fzf \
      --ansi \
      --reverse \
      --height 100% \
      --info right \
      --prompt "󰥨 Search: " \
      --pointer ">" \
      --marker "󰄲" \
      --border "rounded" \
      --border-label=" 󱉭 $(pwd)/ " \
      --border-label-pos center \
      --color 'fg:#cdd6f4,fg+:#cdd6f4,bg+:#313244,border:#a5aac3,pointer:#cba6f7,label:#cdd6f4' \
      --expect=ctrl-y \
      --bind "right:accept" \
      --bind "shift-up:preview-up" \
      --bind "shift-down:preview-down" \
      --bind "ctrl-r:reload($list_command)" \
      --preview-window="right:65%" \
      --preview "
                file={}
                if [[ \"\$file\" == \"..\" ]]; then
                    echo \"󱧰 Move up to parent directory\"
                elif [[ -d \"\$file\" ]]; then
                    echo \"󰉋 Folder: \$file\"
                    echo \"\"
                    $list_command \"\$file\" 2>/dev/null
                elif [[ -f \"\$file\" ]]; then
                    echo \"󰈙 File: \$file\"
                    echo \"\"
                    $PREVIEW_COMMAND --style=numbers --color=always --line-range :500 \"\$file\" 2>/dev/null || cat \"\$file\"
                else
                    echo \"Invalid selection: \$file\"
                fi
            ")

    # Separar la tecla de la selección
    local key
    local selection
    key=$(head -n 1 <<< "$fzf_output")
    selection=$(tail -n +2 <<< "$fzf_output")

    [[ -z "$selection" ]] && break

    # Si se presionó Ctrl+Y, copiar path y salir
    if [[ "$key" == "ctrl-y" ]]; then
      copy_and_print_path "$selection"
      break
    fi

    # Comportamiento por defecto (Enter / Right)
    if [[ "$selection" == ".." ]]; then
      cd .. || break
    elif [[ -d "$selection" ]]; then
      cd "$selection" || break
    elif [[ -f "$selection" ]]; then
      "$EDITOR_CMD" "$selection"
      break
    else
      break
    fi
  done
}

[[ -n "$FZFM_LIST_COMMAND" ]] && LIST_COMMAND="$FZFM_LIST_COMMAND"
[[ -n "$FZFM_PREVIEW_COMMAND" ]] && PREVIEW_COMMAND="$FZFM_PREVIEW_COMMAND"

clear
fzfm
